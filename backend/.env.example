TOURVERSE_DATABASE_URL=jdbc:postgresql://localhost:5432/tourverse_db
TOURVERSE_DATABASE_USER=tourverse_user
TOURVERSE_DATABASE_PASSWORD=replace-with-your-database-password

# Authentication
# Use a unique random value of at least 32 characters in every environment.
TOURVERSE_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Runtime and security
TOURVERSE_ENV=development
# Comma-separated origins. May be omitted only during local development.
TOURVERSE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TOURVERSE_RATE_LIMIT_PER_MINUTE=120
# Development defaults to true; production defaults to false unless explicitly enabled.
TOURVERSE_INCLUDE_DEVELOPMENT_SEED_DATA=true

# Optional destination import providers. Keep keys backend-only.
# OpenTripMap remains disabled until a key and terms/attribution review are complete.
TOURVERSE_OPENTRIPMAP_API_KEY=
# Used only for bounded ADMIN Place ID linking; never for bulk catalogue copying.
TOURVERSE_GOOGLE_PLACES_API_KEY=
